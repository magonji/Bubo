# Password for signing in to the web interface (required).
BUBO_PASSWORD=change-this-password

# Folder on the host where Bubo keeps its database and PDFs. Create it before the
# first start. For an external disk, point it at a folder on the disk, for example:
#   BUBO_DATA_DIR=/mnt/external/bubo
BUBO_DATA_DIR=./data

# Port on 127.0.0.1 where the web interface is published.
BUBO_PORT=2826

# User and group IDs Bubo runs as. Leave empty to use the owner of the data folder.
# On exFAT/NTFS disks these must match the uid/gid the disk is mounted with.
PUID=
PGID=

# Optional contact email: enables open-access PDF lookup via Unpaywall and
# Crossref's "polite pool" (faster and more reliable). It can also be set (and
# changed at any time) in Settings in the web interface, which takes precedence.
BUBO_CONTACT_EMAIL=

# Set to true once Bubo is served over HTTPS (secure-only session cookie).
BUBO_SECURE_COOKIES=false

# Session length in days.
BUBO_SESSION_DAYS=30
